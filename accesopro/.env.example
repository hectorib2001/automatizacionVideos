APP_NAME=AccesoPro
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Más que el timeout de RunSourcePipeline (3600 s): si no, la cola lo reentrega a mitad.
DB_QUEUE_RETRY_AFTER=3700

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- AccesoPro: LLM (Prism) ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_GENERATOR_PROVIDER=anthropic
LLM_GENERATOR_MODEL=claude-sonnet-5-5
LLM_REVIEWER_PROVIDER=anthropic
LLM_REVIEWER_MODEL=claude-opus-5-5
# Para usar Gemini de pago en vez de Claude:
# LLM_GENERATOR_PROVIDER=gemini
# LLM_GENERATOR_MODEL=gemini-3.8-flash
# LLM_REVIEWER_PROVIDER=gemini
# LLM_REVIEWER_MODEL=gemini-3.1-pro-preview

# --- AccesoPro: ElevenLabs (voz clonada) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_USD_PER_1K_CHARS=0.17

# --- AccesoPro: Google Drive (OAuth de tu cuenta personal) ---
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT=AccesoPro

# --- AccesoPro: Groq (transcripción Whisper de la clase grabada) ---
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_WHISPER_USD_PER_HOUR=0.04

# --- AccesoPro: sistema ---
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
YT_DLP_BIN=yt-dlp
PUBLISH_TARGET=drive
DAILY_BUDGET_EUR=5
USD_TO_EUR=0.92

# =============================================================================
# LARAVEL CLOUD: qué cambiar respecto a este archivo (ver docs/DESPLIEGUE_CLOUD.md)
# =============================================================================
# Copia en Environment → Variables todas las claves de "AccesoPro" de arriba
# (ANTHROPIC_API_KEY, ELEVENLABS_*, GOOGLE_DRIVE_*, GROQ_*, PUBLISH_TARGET,
# DAILY_BUDGET_EUR...) con los mismos valores de tu .env local, y además:
#
# APP_ENV=production
# APP_DEBUG=false                 # nunca true en internet: mostraría claves en los errores
# APP_URL=https://<tu-app>.laravel.cloud
# APP_LOCALE=es
# LOG_LEVEL=info
#
# Base de datos: NO uses sqlite (el disco de Cloud es efímero y se borra al desplegar).
# Crea una base de datos en Cloud y adjúntala al entorno: Cloud rellena DB_* solo.
#
# Cola: Cloud configura QUEUE_CONNECTION al activar la cola gestionada. El worker necesita
# timeout de 3600 s, y retry_after por encima:
# DB_QUEUE_RETRY_AFTER=3700
#
# Binarios: FFmpeg y yt-dlp no vienen en Cloud: se descargan en bin/ durante el build
# (comandos en docs/DESPLIEGUE_CLOUD.md, D30). Rutas relativas a la app:
# FFMPEG_BIN=bin/ffmpeg
# FFPROBE_BIN=bin/ffprobe
# YT_DLP_BIN=bin/yt-dlp
#
# Material confidencial: materiales/ no está en git y no existe en Cloud. Allí solo
# funcionan las fuentes subidas desde la página "Fuentes" (PDF y enlaces de YouTube).
# Los vídeos se montan sin logo (SceneBuilder funciona sin él).
